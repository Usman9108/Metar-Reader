@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="error-page">
    <div class="error-page-panel">
        <p class="caution-strip">MASTER CAUTION</p>
        <h1>Something went wrong</h1>
        <p>The request could not be completed. Try again, or head back to the briefing panel.</p>

        @if (Model.ShowRequestId)
        {
            <p class="error-request-id">Request ID: <code>@Model.RequestId</code></p>
        }

        <a class="error-back-link" href="/">&larr; Back to Metar Reader</a>
    </div>
</div>
